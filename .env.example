# Hub password (required in production)
HUB_PASSWORD=

# Authenticator app (TOTP) second factor. Generate with: node scripts/totp-secret.mjs
HUB_TOTP_SECRET=

# Backup code when nobody has a phone. Case sensitive. Change anytime in Vercel env.
HUB_MFA_RECOVERY=

# Optional. Comma-separated SHA-256 hashes of saved backup codes (same formula as UPS Packaging).
HUB_BACKUP_HASHES=
